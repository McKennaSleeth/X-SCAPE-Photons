<?xml version="1.0"?>

<jetscape>
  
  <nEvents> 1000000 </nEvents>

  <outputFilename>photon_AuAu_pTHat3_4_out_alldecayoff_prompt_1M_fixedPID</outputFilename>
   <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <!--<JetScapeWriterFinalStatePartonsAscii> on </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>-->
  
  <!-- Inital State Module  -->
  <IS>
    <Trento>
      <PhysicsInputs  projectile='Au'
                      target='Au'
                      sqrts='200'
                      cross-section='4.2'
                      normalization='5.73'>
      </PhysicsInputs>
      <CutInputs
          centrality-low='0'
          centrality-high='5'>
      </CutInputs>
      <TransInputs  reduced-thickness='0.063'
                    fluctuation="1.05"
                    nucleon-width="1.12"
                    nucleon-min-dist="1.4">
      </TransInputs>
      <LongiInputs  mean-coeff="1.0"
                    std-coeff="3.0"
                    skew-coeff="0.0"
                    skew-type="1"
                    jacobian="0.8">
      </LongiInputs>
    </Trento>
  </IS>
  
  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>3</pTHatMin>
      <pTHatMax>4</pTHatMax>
      <eCM>200</eCM>
      <LinesToRead>
        HardQCD:all = on
        PromptPhoton:all = on
      </LinesToRead>
    </PythiaGun>
  </Hard>

  <!--Eloss Modules -->
  <Eloss>
    <Matter>
      <Q0> 1.0 </Q0>
      <in_vac> 1 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 0 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
    </Matter>
  </Eloss>
    
  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
    <LinesToRead>
      HadronLevel:Decay = off
      <!--
      111:maydecay = off
      221:maydecay = off
      331:maydecay = off
      223:maydecay = off
      113:maydecay = off
      213:maydecay = off
      213:maydecay = off
      333:maydecay = off
      2114:maydecay = off
      2214:maydecay = off
      3212:maydecay = off
      310:maydecay = off
      130:maydecay = off
      3122:maydecay = off
      -->
    </LinesToRead> 
  </JetHadronization>
  
</jetscape>
