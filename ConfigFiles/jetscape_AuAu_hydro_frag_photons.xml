<?xml version="1.0"?>

<jetscape>

  <vlevel> 0 </vlevel>
  <nEvents> 100000 </nEvents>

  <setReuseHydro> true </setReuseHydro>
  <nReuseHydro> 10000000 </nReuseHydro>

  <Random>
    <seed>13</seed>
  </Random>

  <outputFilename>photon_AuAu_pTHat15_100_out_alldecayoff_noprompt_hydro_1M</outputFilename>
   <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <!--<JetScapeWriterAscii> on </JetScapeWriterAscii>
  <JetScapeWriterAsciiGZ> off </JetScapeWriterAsciiGZ> -->
  <write_pthat> 1 </write_pthat>
    
  <!-- Inital State Module  -->
    <IS>
        <grid_max_x> 15 </grid_max_x>
        <grid_max_y> 15 </grid_max_y>
        <grid_max_z> 0 </grid_max_z>
        <!--  <grid_step_x> 0.2 </grid_step_x>
        <grid_step_y> 0.2 </grid_step_y> -->
        <grid_step_x> 0.2 </grid_step_x>
        <grid_step_y> 0.2 </grid_step_y>

        <Trento>
          <PhysicsInputs  projectile='Au'
                  target='Au'
                  sqrts='200'
                  cross-section='4.2'
                  normalization='5.73'>
          </PhysicsInputs>
          <CutInputs
                centrality-low='0'
                centrality-high='5'>
          </CutInputs>
          <TransInputs  reduced-thickness='0.063'
                  fluctuation="1.05"
                  nucleon-width="1.12"
                  nucleon-min-dist="1.4">
          </TransInputs>
          <LongiInputs  mean-coeff="1.0"
                  std-coeff="3.0"
                  skew-coeff="0.0"
                  skew-type="1"
                  jacobian="0.8">
          </LongiInputs>
        </Trento>
    </IS>


    <Hard>
      <PythiaGun>
	<pTHatMin>15</pTHatMin>
	<pTHatMax>100</pTHatMax>
	<eCM>200</eCM>
	<LinesToRead>
          HardQCD:all = on
          PromptPhoton:all = off
	  PDF:useHardNPDFA=on
          PDF:useHardNPDFB=on
          PDF:nPDFSetA=1
          PDF:nPDFSetB=1
          PDF:nPDFBeamA = 100791970
          PDF:nPDFBeamB = 100791970
	</LinesToRead>
      </PythiaGun>
    </Hard>
    
    <!--Preequilibrium Dynamics Module -->

    <Preequilibrium> 
        <tau0>0.0</tau0>
        <tauj>0.1</tauj>
        <taus>1.46</taus>

        <FreestreamMilne>
          <name>FreestreamMilne</name>
	  <freestream_input_file>/home/sleethmr/jetbox/myJETSCAPE/JETSCAPE/build/freestream_input</freestream_input_file>
        </FreestreamMilne>
    </Preequilibrium>

    <!-- Hydro  Module  -->
    <Hydro>
      <MUSIC>
        <beastMode>1</beastMode>
	<MUSIC_input_file>/home/sleethmr/jetbox/myJETSCAPE/JETSCAPE/build/music_input</MUSIC_input_file>
	<!--
	<Initial_time_tau_0>1.46</Initial_time_tau_0>
        <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
        <eta_over_s_T_kink_in_GeV>0.223</eta_over_s_T_kink_in_GeV>
        <eta_over_s_low_T_slope_in_GeV>-0.776</eta_over_s_low_T_slope_in_GeV>
        <eta_over_s_high_T_slope_in_GeV>0.37</eta_over_s_high_T_slope_in_GeV>
        <eta_over_s_at_kink>0.096</eta_over_s_at_kink>
        <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
	<zeta_over_s_max>0.133</zeta_over_s_max>
        <zeta_over_s_T_peak_in_GeV>0.12</zeta_over_s_T_peak_in_GeV>
        <zeta_over_s_width_in_GeV>0.072</zeta_over_s_width_in_GeV>
        <zeta_over_s_lambda_asymm>-0.122</zeta_over_s_lambda_asymm>
        -->
	<freezeout_temperature>0.136</freezeout_temperature>
	
      </MUSIC>
    </Hydro>
    
  <!--Eloss Modules -->
  <Eloss>
    <Matter>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 1 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
      <brick_length> 5.0 </brick_length>
    </Matter>
  </Eloss>
  
  <JetHadronization>
    <name>colorless</name>
    <LinesToRead>
      HadronLevel:Decay = off
      <!--
	  111:maydecay = off
	  221:maydecay = off
	  331:maydecay = off
	  223:maydecay = off
	  113:maydecay = off
	  213:maydecay = off
	  -213:maydecay = off
	  333:maydecay = off
	  2114:maydecay = off
	  2214:maydecay = off
	  3212:maydecay = off
	  310:maydecay = off
	  130:maydecay = off
	  3122:maydecay = off
      -->
    </LinesToRead>
  </JetHadronization>
  
</jetscape>
