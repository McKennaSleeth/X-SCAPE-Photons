<?xml version="1.0"?>

<jetscape>

  <nEvents> 1000 </nEvents>
  <setReuseHydro> false </setReuseHydro>
  <nReuseHydro> 100 </nReuseHydro>

<!--  <JetScapeWriterAscii> on </JetScapeWriterAscii> -->
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <outputFilename>jetscape_AuAu_pTHat18_20_hard_soft_hydro10_centr0_10_1k_events_SMASH_only_decay</outputFilename>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 100 </nEvents_printout>

  <Random>
    <seed>0</seed>
  </Random>
  <!-- Inital State Module  -->
  <IS>
    <!--<initial_profile_path>REPLACE_HYDRO_DIR</initial_profile_path>-->

    <grid_max_x> 15 </grid_max_x>
    <grid_max_y> 15 </grid_max_y>
    <grid_max_z> 0 </grid_max_z>
    <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y>

    <Trento>
      <PhysicsInputs  projectile='Au'
                      target='Au'
                      sqrts='200'
                      cross-section='4.2'
                      normalization='5.73'>
      </PhysicsInputs>
      <CutInputs
          centrality-low='0'
          centrality-high='10'>
      </CutInputs>
      <TransInputs  reduced-thickness='0.063'
                    fluctuation="0.918"
                    nucleon-width="0.956"
                    nucleon-min-dist="1.27">
      </TransInputs>
      <LongiInputs  mean-coeff="1.0"
                    std-coeff="3.0"
                    skew-coeff="0.0"
                    skew-type="1"
                    jacobian="0.8">
      </LongiInputs>
    </Trento>
  </IS>

  <!-- Hard Process -->
  
  <Hard>
    <PythiaGun>
      <FSR_on>0</FSR_on>
      <pTHatMin>18</pTHatMin>
      <pTHatMax>20</pTHatMax>
      <eCM>200</eCM>
      <LinesToRead>
	HardQCD:all = on
	PromptPhoton:all = off
	PDF:useHardNPDFA=on
        PDF:useHardNPDFB=on
        PDF:nPDFSetA=1
        PDF:nPDFSetB=1
        PDF:nPDFBeamA = 100791970
        PDF:nPDFBeamB = 100791970
      </LinesToRead>
    </PythiaGun>
  </Hard>
  
  
  <Preequilibrium>
    
    <!--<NullPreDynamics> </NullPreDynamics>-->
    <tau0>0.0</tau0>
    <tauj>0.1</tauj>
    
    <taus>1.46</taus>
    <evolutionInMemory>1</evolutionInMemory>
    
    
    <FreestreamMilne>
      <name>FreestreamMilne</name>
      <freestream_input_file>freestream_input</freestream_input_file>
    </FreestreamMilne>
  </Preequilibrium>
  
  
  <Hydro>
    <!--
    <hydro_from_file>
      <name>Hydro from file </name>
      <read_in_multiple_hydro>1</read_in_multiple_hydro>
      <hydro_files_folder>REPLACE_HYDRO_DIR</hydro_files_folder>
    </hydro_from_file>
    -->
    <MUSIC>
      <beastMode>1</beastMode>
      <output_evolution_to_file>0</output_evolution_to_file>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      <surface_in_memory>1</surface_in_memory>
      <Initial_time_tau_0>1.46</Initial_time_tau_0>
      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      <eta_over_s_T_kink_in_GeV>0.223</eta_over_s_T_kink_in_GeV>
      <eta_over_s_low_T_slope_in_GeV>-0.776</eta_over_s_low_T_slope_in_GeV>
      <eta_over_s_high_T_slope_in_GeV>0.37</eta_over_s_high_T_slope_in_GeV>
      <eta_over_s_at_kink>0.096</eta_over_s_at_kink>
      <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
      <zeta_over_s_max>0.133</zeta_over_s_max>
      <zeta_over_s_T_peak_in_GeV>0.12</zeta_over_s_T_peak_in_GeV>
      <zeta_over_s_width_in_GeV>0.072</zeta_over_s_width_in_GeV>
      <zeta_over_s_lambda_asymm>-0.122</zeta_over_s_lambda_asymm>
      <freezeout_temperature>0.136</freezeout_temperature>
    </MUSIC>
  </Hydro>

  <SoftParticlization>
    <iSS>
      <!-- file path for the default input file  -->
      <iSS_input_file>iSS_parameters.dat</iSS_input_file>
      <!-- directory path where the hydro surface is stored-->
      <iSS_table_path>iSS_tables</iSS_table_path>
      <!-- file path for the default particle table files-->
      <iSS_particle_table_path>iSS_tables</iSS_particle_table_path>
      <afterburner_type>1</afterburner_type>
      <number_of_repeated_sampling>1</number_of_repeated_sampling>
      <Perform_resonance_decays>0</Perform_resonance_decays>
    </iSS>
  </SoftParticlization>

    
  <Afterburner>
    <SMASH>
      <name>SMASH</name>
      <SMASH_config_file>smash_config.yaml</SMASH_config_file>
      <SMASH_particles_file>particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>decaymodes.txt</SMASH_decaymodes_file>
      <only_decays>1</only_decays>
      <!--<end_time>25</end_time>--> <!-- default end_time is 1000 fm/c -->
    </SMASH>
  </Afterburner>

  
  <Eloss>

    <deltaT>0.1</deltaT>
    <formTime> -0.1</formTime>
    <maxT>150</maxT>
    <tStart> 0.6 </tStart> 
    <mutex>ON</mutex>

    <Matter>
      <name>Matter</name>
      <matter_on> 1 </matter_on>
      <Q0> 2.0 </Q0>
      <T0> 0.16 </T0>
      <vir_factor> 0.25 </vir_factor>
      <in_vac> 0 </in_vac>
      <recoil_on> 1 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>   
      <brick_length> 5.0 </brick_length>
      <hydro_Tc> 0.16 </hydro_Tc>
      
      <QhatParametrizationType> 5  </QhatParametrizationType>
      <qhat0> -2.0 </qhat0>  
      <alphas> 0.3 </alphas>
      <qhatA> 10.0 </qhatA>    
      <qhatB> 100.0 </qhatB>    
      <qhatC> 0.2 </qhatC>    
      <qhatD> 5.0 </qhatD>    
    </Matter>

    <Lbt>
      <name> Lbt </name>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <only_leading> 0 </only_leading>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.3 </alphas>
      <run_alphas>1</run_alphas>   
    </Lbt>
  </Eloss>

  <JetHadronization>
    <name>colorless</name>
    <take_recoil>1</take_recoil>
    <eCMforHadronization>100</eCMforHadronization>
    <LinesToRead>
      HadronLevel:Decay = off      
    </LinesToRead>
  </JetHadronization>
</jetscape>
