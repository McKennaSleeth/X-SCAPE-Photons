<?xml version="1.0"?>

<jetscape>
  
  <nEvents> 10000000 </nEvents>

  <outputFilename>photon_pp_pTHat15_40_out_alldecayoff_yesprompt_10M</outputFilename>
   <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <!--<JetScapeWriterFinalStatePartonsAscii> on </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>
  -->
  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>15</pTHatMin>
      <pTHatMax>40</pTHatMax>
      <eCM>200</eCM>
      <LinesToRead>
        HardQCD:all = on
        PromptPhoton:all = on
      </LinesToRead>
    </PythiaGun>
  </Hard>

  <!--Eloss Modules -->
  <Eloss>
    <Matter>
      <Q0> 1.0 </Q0>
      <in_vac> 1 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 0 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
    </Matter>
  </Eloss>
    
  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
    <LinesToRead>
      HadronLevel:Decay = off
      <!--
      111:maydecay = off
      221:maydecay = off
      331:maydecay = off
      223:maydecay = off
      113:maydecay = off
      213:maydecay = off
      -213:maydecay = off
      333:maydecay = off
      2114:maydecay = off
      2214:maydecay = off
      3212:maydecay = off
      310:maydecay = off
      130:maydecay = off
      3122:maydecay = off
      -->
    </LinesToRead> 
  </JetHadronization>
  
</jetscape>
